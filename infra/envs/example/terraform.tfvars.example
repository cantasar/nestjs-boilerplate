# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored
# (never commit real values).

# --- Required ---
project_id       = "TODO-your-gcp-project-id"    # gcloud config get-value project
region           = "TODO-region"                 # e.g. europe-west1
data_region      = "TODO-data-region"            # Cloud SQL/Memorystore region — ignored if both disabled below
api_service_name = "TODO-cloud-run-service-name"

# --- Existing repo (created by apply if missing) ---
# artifact_registry_repo = "cloud-run-source-deploy"

# --- Data-plane choice: this is the first decision to make ---
# Defaults here (false/false) assume the realistic fresh-project path: an
# external managed DB/Redis (Neon, Supabase, Upstash, ...) reached over the
# public internet — no VPC, no PSA, no Cloud SQL/Memorystore cost. Flip
# either to true to have Terraform provision GCP-managed Cloud SQL /
# Memorystore instead (see infra/README.md's "Data-plane toggles" section).
enable_cloud_sql   = false
enable_memorystore = false

# --- New resource names (only matter if the toggles above are true) ---
# vpc_name                  = "app-vpc"
# cloud_sql_instance_name   = "app-db"
# cloud_sql_tier            = "db-f1-micro"
# memorystore_instance_name = "app-redis"
# runtime_bucket_names      = []   # only if GCS_BUCKET is set (see .env.example)

# --- Rollout toggles ---
manage_api_template = true   # true = fresh greenfield apply. Set false first if importing an existing service (see README runbook).
enable_migrate_job  = false
enable_lb           = false

# api_domain      = "api.example.com"
# bootstrap_image = ""   # set to a real image URI before first apply
