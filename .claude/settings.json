{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import *)",
      "Bash(terraform state *)",
      "Bash(terraform taint *)",
      "Bash(gcloud run deploy *)",
      "Bash(gcloud builds submit *)",
      "Bash(aws ecs update-service *)",
      "Bash(aws ecs register-task-definition *)",
      "Bash(aws ecr get-login-password*)",
      "Bash(aws secretsmanager get-secret-value *)",
      "Bash(aws secretsmanager put-secret-value *)",
      "Bash(docker push *)",
      "Bash(docker image push *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(terraform init*)",
      "Bash(terraform plan*)",
      "Bash(pnpm db:*)",
      "Bash(docker compose *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Agent|Task|mcp__.*__run_in_terminal|mcp__.*__preview_start|mcp__.*__navigate",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
