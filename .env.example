# Template only. Copy to .env and fill in. Never put real secrets in this file.
# Every variable is checked at boot by src/modules/shared/common/config/env.schema.ts.

# App
NODE_ENV=development
PORT=3000
# Comma list. Empty = all origins in dev, none in production.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
# BODY_PARSER_LIMIT=1mb

# Database (matches docker-compose.yml). DATABASE_URL wins over the separate parts.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=app

# Redis
REDIS_URL=redis://localhost:6379

# JWT. Production needs a random secret of 32+ characters.
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Server-to-server key for @ApiKeyAuth() routes. Unset = those routes always reject.
# API_KEY=change_me

# Social login (set the ones you use)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# APPLE_BUNDLE_ID=com.example.app

# Email verification overrides (defaults in auth.constants.ts)
# AUTH_EMAIL_VERIFY_SESSION_TTL_SECONDS=900
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_RESEND_RATE_LIMIT_MAX=5
# AUTH_RESEND_RATE_LIMIT_WINDOW_SECONDS=60
# Local testing only: returns the code in the response. Ignored in production.
# AUTH_DEBUG_RETURN_OTP=true

# Queues (BullMQ)
# QUEUE_PREFIX=app
# QUEUE_CONCURRENCY=5
# QUEUE_DEFAULT_ATTEMPTS=3
# QUEUE_DEFAULT_BACKOFF_MS=1000

# Global rate limit (per IP)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_REDIS_PREFIX=throttle:

# Mail (ZeptoMail). Mail is skipped with a warning until these are set.
# ZEPTOMAIL_URL=https://api.zeptomail.com/
# ZEPTOMAIL_TOKEN=change_me
# MAIL_FROM_ADDRESS=no-reply@example.com
# MAIL_FROM_NAME=App
# MAIL_LOGO_URL=https://example.com/logo.png
# APP_PUBLIC_URL=https://api.example.com

# Swagger. On by default outside production.
# SWAGGER_ENABLED=true
# SWAGGER_BASIC_AUTH_USER=admin
# SWAGGER_BASIC_AUTH_PASSWORD=change_me
# SWAGGER_SERVERS=https://api.example.com|Production,https://staging-api.example.com|Staging

# First admin seed. Set both to create an admin once on startup.
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD=change_me_min_8

# Docker entrypoint: set to false to skip migrations on container start.
# RUN_MIGRATIONS=true

# Webhooks read their URL and secret from env vars you name per endpoint, for example:
# ORDER_EVENTS_WEBHOOK_URL=https://receiver.example.com/hooks/orders
# ORDER_EVENTS_WEBHOOK_SECRET=change_me
